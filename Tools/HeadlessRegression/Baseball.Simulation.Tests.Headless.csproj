<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="UnityNUnit.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Baseball.Simulation.Tests</AssemblyName>
    <RootNamespace>Baseball.Tests.EditMode.Simulation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\Tests\EditMode\Simulation\**\*.cs" />
    <ProjectReference Include="Baseball.Core.Headless.csproj" />
    <ProjectReference Include="Baseball.Simulation.Headless.csproj" />
  </ItemGroup>
</Project>

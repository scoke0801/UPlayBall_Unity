<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity 에디터 없이 실제 Career/World 진행 경로를 Release로 돌리는 회귀 러너다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Baseball.Tools.WorldRegression</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Baseball.Core.Headless.csproj" />
    <ProjectReference Include="..\Baseball.Simulation.Headless.csproj" />
    <ProjectReference Include="..\Baseball.Game.Headless.csproj" />
  </ItemGroup>
</Project>
